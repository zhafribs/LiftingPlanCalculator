<?xml version="1.0" encoding="utf-8"?>
<!--
  The round icon, for API 26 and up.  Identical to `ic_launcher.xml`: from API 26 the
  launcher masks the icon itself, so "round" is no longer a different drawing; the
  two files exist because the manifest still names both.
-->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
